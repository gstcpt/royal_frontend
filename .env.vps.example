# ==============================================================================
# ROYAL FRONTEND — VPS OXAHOST PRODUCTION TEMPLATE (/opt/royal/frontend/.env)
# Copy this file to .env on VPS inside /opt/royal/frontend/
# ==============================================================================

APP_NAME="Royal — Electro de Maison"
NODE_ENV=production
PORT=3100
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# Browser calls route through same-origin /api/v1 proxy
NEXT_PUBLIC_API_URL=/api/v1

# SSR & /api/v1 proxy target on VPS localhost
INTERNAL_API_URL=http://127.0.0.1:4000
BACKEND_INTERNAL_URL=http://127.0.0.1:4000/api/v1
